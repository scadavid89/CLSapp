# Front end. Copy to .env for local dev. .env is gitignored.
# ANYTHING PREFIXED VITE_ IS INLINED INTO THE BROWSER BUNDLE AND IS PUBLIC.
# Never put a secret behind this prefix.

VITE_API_BASE=http://localhost:7071/api

# ---------------------------------------------------------------------
# Server-side settings live in api/local.settings.json locally, and in
# Azure app settings / Key Vault in production. They are NOT read from
# this file and must never carry a VITE_ prefix:
#
#   SQL_SERVER, SQL_DATABASE, SQL_USER, SQL_PASSWORD
#   QBO_CLIENT_ID, QBO_CLIENT_SECRET, QBO_REALM_ID
#
# In Azure the API authenticates to SQL with its managed identity, so
# SQL_USER and SQL_PASSWORD are set only for local development.
# ---------------------------------------------------------------------
