{
  "$schema": "https://aka.ms/azure/static-web-apps-cli/schema",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.js", "/*.css", "/*.ico", "/*.png", "/*.svg", "/*.webmanifest"]
  },
  "mimeTypes": {
    ".js": "text/javascript",
    ".mjs": "text/javascript",
    ".css": "text/css",
    ".json": "application/json"
  },
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["yard", "dispatch", "ops", "finance", "admin", "customer"]
    }
  ],
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/.auth/login/aad" },
    "403": { "statusCode": 302, "redirect": "/.auth/login/aad" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
