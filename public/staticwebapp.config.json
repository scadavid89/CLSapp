{
  "$schema": "https://aka.ms/azure/static-web-apps-cli/schema",
  "platform": { "apiRuntime": "node:20" },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "/*.js", "/*.css", "/*.ico", "/*.png", "/*.svg", "/*.webmanifest"]
  },
  "mimeTypes": {
    ".js": "text/javascript",
    ".mjs": "text/javascript",
    ".css": "text/css",
    ".json": "application/json"
  },
  "routes": [
    { "route": "/api/reports/*", "allowedRoles": ["ops", "finance", "admin"] },
    { "route": "/api/products/*", "allowedRoles": ["ops", "admin"] },
    { "route": "/api/assets/*", "allowedRoles": ["ops", "admin"] },
    { "route": "/api/stock", "allowedRoles": ["ops", "admin"] },
    { "route": "/api/scan/*", "allowedRoles": ["yard", "dispatch", "ops", "admin"] },
    { "route": "/api/quotes/*", "allowedRoles": ["dispatch", "ops", "finance", "admin"] },
    { "route": "/api/*", "allowedRoles": ["yard", "dispatch", "ops", "finance", "admin", "customer"] },
    { "route": "/*", "allowedRoles": ["yard", "dispatch", "ops", "finance", "admin", "customer"] }
  ],
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/.auth/login/aad" },
    "403": { "statusCode": 302, "redirect": "/.auth/login/aad" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
